# ESP32-S3 USB Host + ADB project config
# Chip: ESP32-S3 (GOOUUU ESP32-S3 N16R8)
# USB PHY: D+ = GPIO20, D- = GPIO19

# Target chip
CONFIG_IDF_TARGET="esp32s3"

# ---- USB Host core (provided by IDF 'usb' component) ----
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=256
CONFIG_USB_HOST_BULK_TRANSFER_MAX_SIZE=512
CONFIG_USB_HOST_MAX_DEVICES=1
CONFIG_USB_HOST_MAX_ENDPOINTS=8
CONFIG_USB_HOST_STACK_SIZE=4096

# ---- mbedTLS: RSA/SHA1 for ADB AUTH signing ----
CONFIG_MBEDTLS_PK_C=y
CONFIG_MBEDTLS_PK_PARSE_KEYFILE=y
CONFIG_MBEDTLS_RSA_C=y
CONFIG_MBEDTLS_SHA1_C=y
CONFIG_MBEDTLS_ASN1_PARSE_C=y
CONFIG_MBEDTLS_BIGNUM_C=y
CONFIG_MBEDTLS_CTR_DRBG_C=y

# ---- UART console & log ----
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# ---- Disable unused to save memory ----
CONFIG_BT=n
CONFIG_WIFI=n
